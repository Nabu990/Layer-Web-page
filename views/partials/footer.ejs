<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
<style>
/* Footer Styling */
footer {
  background-color: #f1f1f1;
  padding: 40px 60px;
  border-top: 2px solid #e6e6e6;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  color: #333;
}

.footer-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 2rem;
  max-width: 1200px;
  margin: auto;
}

.footer-section {
  flex: 1;
  min-width: 220px;
}

.footer-section h3 {
  font-size: 1.3rem;
  color: #003366;
  margin-bottom: 1rem;
}

.footer-section ul {
  list-style: none;
  padding: 0;
}

.footer-section ul li {
  margin-bottom: 0.5rem;
}

.footer-section ul li a {
  text-decoration: none;
  color: #444;
  font-size: 0.95rem;
  transition: color 0.3s ease;
}

.footer-section ul li a:hover {
  color: #006400;
}

.footer-bottom {
  margin-top: 40px;
  border-top: 1px solid #ccc;
  padding-top: 20px;
  text-align: center;
  font-size: 0.9rem;
  color: #777;
}

.footer-social {
  display: flex;
  gap: 1rem;
  margin-top: 1rem;
}

.footer-social a {
  color: #003366;
  font-size: 1.2rem;
  transition: color 0.3s ease;
}

.footer-social a:hover {
  color: #006400;
}

</style>
</head>
<body>
  <footer>
  <div class="footer-container">
    <div class="footer-section">
      <h3>About Us</h3>
      <p>We are a team committed to providing excellent services and building trust.</p>
    </div>
    <div class="footer-section">
      <h3>Quick Links</h3>
      <ul>
        <li><a href="/about">About</a></li>
        <li><a href="/team">Team</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>
    <div class="footer-section">
      <h3>Follow Us</h3>
      <div class="footer-social">
        <a href="#"><i class="fab fa-facebook-f"></i></a>
        <a href="#"><i class="fab fa-twitter"></i></a>
        <a href="#"><i class="fab fa-linkedin-in"></i></a>
        <a href="#"><i class="fab fa-instagram"></i></a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    &copy; 2025 Wlies Associates. All rights reserved.
  </div>
</footer>


</body>
</html>